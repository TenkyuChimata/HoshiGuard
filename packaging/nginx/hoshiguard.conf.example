# nginx の http コンテキストに配置する。公開時はプロキシで TLS を設定する。
map $http_upgrade $hoshiguard_connection {
    default upgrade;
    '' close;
}
limit_req_zone $binary_remote_addr zone=hoshiguard_requests:1m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=hoshiguard_connections:1m;

server {
    listen 80;
    server_name alerts.example.org;
    client_max_body_size 1k;
    client_header_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;

    location /api/v1/ {
        limit_req zone=hoshiguard_requests burst=20 nodelay;
        limit_conn hoshiguard_connections 8;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hoshiguard_connection;
        proxy_read_timeout 75s;
        proxy_send_timeout 10s;
        proxy_buffering off;
        proxy_cache off;
    }
    location / { return 404; }
}
