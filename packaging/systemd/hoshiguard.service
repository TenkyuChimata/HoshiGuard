[Unit]
Description=HoshiGuard QZSS disaster JSON API
After=local-fs.target network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=hoshiguard
Group=hoshiguard
SupplementaryGroups=dialout
WorkingDirectory=/opt/hoshiguard
EnvironmentFile=/etc/hoshiguard/hoshiguard.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hoshiguard/.venv/bin/hoshiguard --port ${HOSHIGUARD_PORT} --baud ${HOSHIGUARD_BAUD} --api --api-host ${HOSHIGUARD_API_HOST} --api-port ${HOSHIGUARD_API_PORT}
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/hoshiguard
StateDirectory=hoshiguard
StateDirectoryMode=0750
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
